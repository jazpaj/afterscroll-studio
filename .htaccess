# Afterscroll Studio -- Apache / LiteSpeed (cPanel). Generated by _generator/build.py.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# one canonical host: afterscrollstudio.com -> www.afterscrollstudio.com
RewriteCond %{HTTP_HOST} ^afterscrollstudio\.com$ [NC]
RewriteRule ^(.*)$ https://www.afterscrollstudio.com/$1 [R=301,L]
</IfModule>

# never serve the source, docs or repo metadata if they get uploaded
RedirectMatch 404 ^/(_generator|\.git|\.claude)(/|$)
RedirectMatch 404 ^/(README\.md|\.gitignore|\.nojekyll)$

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
